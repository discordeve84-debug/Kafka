rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidSession(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.mode in ['AGENT', 'WEB_SEARCH', 'JOURNAL_RESEARCH', 'FACT_VERIFY', 'DOC_STUDIO'] &&
             data.activeSkillIds is list && data.activeSkillIds.size() <= 10 &&
             (data.activeSkillIds.size() == 0 || data.activeSkillIds[0] is string) &&
             data.lastSummary is string && data.lastSummary.size() <= 2000 &&
             data.verifiedScore is int && data.verifiedScore >= 0 && data.verifiedScore <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMessage(data, userId) {
      return data.userId == userId &&
             data.role in ['USER', 'AGENT'] &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 30000 &&
             data.thoughtSteps is list && data.thoughtSteps.size() <= 20 &&
             (data.thoughtSteps.size() == 0 || data.thoughtSteps[0] is string) &&
             data.verificationStatus in ['VERIFIED', 'PARTIAL', 'UNVERIFIED', 'NONE'] &&
             data.verificationScore is int && data.verificationScore >= 0 && data.verificationScore <= 100 &&
             data.verificationSummary is string && data.verificationSummary.size() <= 2000 &&
             data.citations is list && data.citations.size() <= 15 &&
             (data.citations.size() == 0 || data.citations[0] is map) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidSkill(data, userId) {
      return data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 1000 &&
             data.category in ['DOCUMENT', 'RESEARCH', 'VERIFICATION', 'GITHUB', 'CUSTOM'] &&
             data.sourceType in ['BUILTIN', 'GITHUB', 'AI_CREATED'] &&
             (!('githubRepo' in data) || (data.githubRepo is string && data.githubRepo.size() <= 200)) &&
             (!('githubUrl' in data) || (data.githubUrl is string && data.githubUrl.size() <= 500)) &&
             data.systemPrompt is string && data.systemPrompt.size() >= 1 && data.systemPrompt.size() <= 8000 &&
             data.outputFormat in ['DOCX', 'PDF', 'PPTX', 'MARKDOWN', 'CSV', 'JSON', 'RESEARCH'] &&
             data.enabled is bool &&
             data.usageCount is int && data.usageCount >= 0 && data.usageCount <= 100000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.bio is string && data.bio.size() <= 300 &&
             data.darkTheme is bool &&
             data.defaultFormat in ['DOCX', 'PDF', 'PPTX', 'MARKDOWN', 'CSV'] &&
             data.autoVerify is bool &&
             data.preferredLanguage in ['Indonesia', 'English'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidArtifact(data, userId) {
      return data.userId == userId &&
             data.sessionId is string && data.sessionId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.format in ['DOCX', 'PDF', 'PPTX', 'MARKDOWN', 'CSV'] &&
             data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 150 &&
             data.localPath is string && data.localPath.size() <= 500 &&
             data.summary is string && data.summary.size() <= 2000 &&
             data.wordCount is int && data.wordCount >= 0 && data.wordCount <= 1000000 &&
             data.verified is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidResearchSnapshot(data, userId) {
      return data.userId == userId &&
             data.sourceSessionId is string && data.sourceSessionId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.notes is string && data.notes.size() <= 1000 &&
             data.mode in ['AGENT', 'WEB_SEARCH', 'JOURNAL_RESEARCH', 'FACT_VERIFY', 'DOC_STUDIO'] &&
             data.activeSkillIds is list && data.activeSkillIds.size() <= 15 &&
             data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 500 &&
             data.messagesArchive is list && data.messagesArchive.size() <= 25 &&
             data.citations is list && data.citations.size() <= 30 &&
             data.hasActivePreview is bool &&
             data.previewFormat is string && data.previewFormat.size() <= 20 &&
             data.previewTitle is string && data.previewTitle.size() <= 200 &&
             data.previewSubtitle is string && data.previewSubtitle.size() <= 300 &&
             data.previewSummary is string && data.previewSummary.size() <= 2000 &&
             data.previewSections is list && data.previewSections.size() <= 15 &&
             data.previewReferences is list && data.previewReferences.size() <= 20 &&
             data.verifiedScore is int && data.verifiedScore >= 0 && data.verifiedScore <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'bio', 'darkTheme', 'defaultFormat', 'autoVerify', 'preferredLanguage', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'bio', 'darkTheme', 'defaultFormat', 'autoVerify', 'preferredLanguage', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bio', 'darkTheme', 'defaultFormat', 'autoVerify', 'preferredLanguage', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /users/{userId}/sessions/{sessionId} {
      allow get: if isOwner(userId) && isValidId(sessionId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(sessionId) &&
                       incoming().keys().hasAll(['userId', 'title', 'mode', 'activeSkillIds', 'lastSummary', 'verifiedScore', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'mode', 'activeSkillIds', 'lastSummary', 'verifiedScore', 'createdAt', 'updatedAt']) &&
                       isValidSession(incoming(), userId);
      allow update: if isOwner(userId) &&
                       isValidId(sessionId) &&
                       isValidSession(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'mode', 'activeSkillIds', 'lastSummary', 'verifiedScore', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(sessionId);

      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(sessionId) && isValidId(messageId);
        allow list: if isOwner(userId) && isValidId(sessionId);
        allow create: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll(['userId', 'role', 'content', 'thoughtSteps', 'verificationStatus', 'verificationScore', 'verificationSummary', 'citations', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'role', 'content', 'thoughtSteps', 'verificationStatus', 'verificationScore', 'verificationSummary', 'citations', 'createdAt']) &&
                         isValidMessage(incoming(), userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(sessionId) && isValidId(messageId);
      }
    }

    match /users/{userId}/skills/{skillId} {
      allow get: if isOwner(userId) && isValidId(skillId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(skillId) &&
                       incoming().keys().hasAll(['userId', 'name', 'slug', 'description', 'category', 'sourceType', 'systemPrompt', 'outputFormat', 'enabled', 'usageCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'slug', 'description', 'category', 'sourceType', 'githubRepo', 'githubUrl', 'systemPrompt', 'outputFormat', 'enabled', 'usageCount', 'createdAt', 'updatedAt']) &&
                       isValidSkill(incoming(), userId);
      allow update: if isOwner(userId) &&
                       isValidId(skillId) &&
                       isValidSkill(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description', 'category', 'systemPrompt', 'outputFormat', 'enabled', 'usageCount', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(skillId);
    }

    match /users/{userId}/artifacts/{artifactId} {
      allow get: if isOwner(userId) && isValidId(artifactId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(artifactId) &&
                       incoming().keys().hasAll(['userId', 'sessionId', 'title', 'format', 'fileName', 'localPath', 'summary', 'wordCount', 'verified', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'sessionId', 'title', 'format', 'fileName', 'localPath', 'summary', 'wordCount', 'verified', 'createdAt', 'updatedAt']) &&
                       isValidArtifact(incoming(), userId);
      allow update: if isOwner(userId) &&
                       isValidId(artifactId) &&
                       isValidArtifact(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'localPath', 'summary', 'wordCount', 'verified', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(artifactId);
    }

    match /users/{userId}/researchLibrary/{snapshotId} {
      allow get: if isOwner(userId) && isValidId(snapshotId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(snapshotId) &&
                       incoming().keys().hasAll([
                         'userId', 'sourceSessionId', 'title', 'notes', 'mode', 'activeSkillIds',
                         'messageCount', 'messagesArchive', 'citations', 'hasActivePreview',
                         'previewFormat', 'previewTitle', 'previewSubtitle', 'previewSummary',
                         'previewSections', 'previewReferences', 'verifiedScore', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'sourceSessionId', 'title', 'notes', 'mode', 'activeSkillIds',
                         'messageCount', 'messagesArchive', 'citations', 'hasActivePreview',
                         'previewFormat', 'previewTitle', 'previewSubtitle', 'previewSummary',
                         'previewSections', 'previewReferences', 'verifiedScore', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidResearchSnapshot(incoming(), userId);
      allow update: if isOwner(userId) &&
                       isValidId(snapshotId) &&
                       isValidResearchSnapshot(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'notes', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(snapshotId);
    }
  }
}
